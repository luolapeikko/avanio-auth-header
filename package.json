{
  "name": "@avanio/auth-header",
  "version": "0.0.5",
  "description": "Typescript/Javascript http auth header utils",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luolapeikko/avanio-auth-header.git"
  },
  "keywords": [
    "http",
    "header",
    "auth",
    "typescript"
  ],
  "author": "mharj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AvanioOy/auth-header/issues"
  },
  "homepage": "https://github.com/AvanioOy/auth-header#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.5",
    "c8": "^10.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
